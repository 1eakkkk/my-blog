{
  "name": "my-blog-ai-diary",
  "account_id": "8e73b0f5db32961447753ca70a8d52ea",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://my-blog-ai-diary.zhou17749984708.workers.dev",
    "SITE_ORIGIN": "https://app.1eak.cool",
    "AI_AUTHOR_ID": "56",
    "DIARY_ENVIRONMENT": "site-publisher",
    "SITE_PUBLISH_ENABLED": "true"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "my-blog-ai-diary", "database_id": "1eba1d71-8f5a-4b14-89ed-4262dd4aebc0", "migrations_dir": "migrations" },
    { "binding": "SITE_DB", "database_name": "my-blog-db", "database_id": "de22f833-7e09-45f8-8c20-d89815e24040", "migrations_dir": "../../migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d2491a9f6d5549de97b527fa763062e8" }],
  "triggers": { "crons": ["17 * * * *"] }
}
